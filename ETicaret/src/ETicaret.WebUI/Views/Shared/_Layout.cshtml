@inject ETicaret.WebUI.Services.ICartService CartService
@{ var cartCount = CartService.GetCart().ItemCount; }
<!DOCTYPE html>
<html lang="tr" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0a0b10" />
    <title>@(ViewData["Title"] is string t ? $"{t} · Jona" : "Jona")</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
</head>
<body>
<nav class="navbar navbar-expand-lg site-nav sticky-top">
    <div class="container">
        <a class="navbar-brand brand" asp-controller="Home" asp-action="Index">jona<span>.</span></a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav"><span class="navbar-toggler-icon"></span></button>
        <div class="collapse navbar-collapse" id="nav">
            <form class="d-flex ms-lg-4 my-2 my-lg-0 flex-grow-1 search" asp-controller="Home" asp-action="Index" method="get">
                <i class="bi bi-search"></i>
                <input class="form-control" name="Search" placeholder="Ürün ara…" value="@Context.Request.Query["Search"]" />
            </form>
            <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
                <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Contact" asp-action="Index"><i class="bi bi-chat-dots"></i> Bize ulaşın</a></li>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Cart" asp-action="Index">
                        <i class="bi bi-bag"></i> Sepet
                        @if (cartCount > 0) { <span class="badge rounded-pill cart-badge">@cartCount</span> }
                    </a>
                </li>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown"><i class="bi bi-person"></i> @User.DisplayName()</a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            @if (User.IsInRole("Admin"))
                            {
                                <li><a class="dropdown-item" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Yönetim Paneli</a></li>
                            }
                            <li><a class="dropdown-item" asp-area="" asp-controller="Profile" asp-action="Index">Profilim</a></li>
                            <li><a class="dropdown-item" asp-area="" asp-controller="Profile" asp-action="Addresses">Ayarlar</a></li>
                            <li><a class="dropdown-item" asp-controller="Order" asp-action="MyOrders">Siparişlerim</a></li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                                    <button class="dropdown-item">Çıkış yap</button>
                                </form>
                            </li>
                        </ul>
                    </li>
                }
                else
                {
                    <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">Giriş</a></li>
                    <li class="nav-item"><a class="btn btn-accent btn-sm" asp-controller="Account" asp-action="Register">Üye ol</a></li>
                }
            </ul>
        </div>
    </div>
</nav>

<main class="container py-4">
    <partial name="_Alerts" />
    @RenderBody()
</main>

<footer class="site-footer">
    <div class="container">
        <div class="row g-4 footer-top">
            <div class="col-lg-4">
                <a class="brand" asp-area="" asp-controller="Home" asp-action="Index">jona<span>.</span></a>
                <p class="mt-2 mb-3">Seçilmiş ürünler, ücretsiz kargo ve 14 gün kolay iade ile sade bir alışveriş deneyimi.</p>
                <a class="btn btn-sm footer-contact" asp-area="" asp-controller="Contact" asp-action="Index"><i class="bi bi-chat-dots"></i> Bize ulaşın</a>
            </div>
            <div class="col-6 col-md-4 col-lg-2 offset-lg-1">
                <h2 class="footer-title">Kurumsal</h2>
                <ul class="footer-links">
                    <li><a asp-area="" asp-controller="Info" asp-action="About">Hakkımızda</a></li>
                    <li><a asp-area="" asp-controller="Contact" asp-action="Index">İletişim</a></li>
                    <li><a asp-area="" asp-controller="Info" asp-action="Privacy">Gizlilik politikası</a></li>
                    <li><a asp-area="" asp-controller="Info" asp-action="Terms">Kullanım koşulları</a></li>
                </ul>
            </div>
            <div class="col-6 col-md-4 col-lg-2">
                <h2 class="footer-title">Yardım</h2>
                <ul class="footer-links">
                    <li><a asp-area="" asp-controller="Info" asp-action="Faq">Sık sorulan sorular</a></li>
                    <li><a asp-area="" asp-controller="Info" asp-action="Shipping">Kargo ve teslimat</a></li>
                    <li><a asp-area="" asp-controller="Info" asp-action="Returns">İptal ve iade</a></li>
                </ul>
            </div>
            <div class="col-6 col-md-4 col-lg-3">
                <h2 class="footer-title">Hesabım</h2>
                <ul class="footer-links">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li><a asp-area="" asp-controller="Profile" asp-action="Index">Profilim</a></li>
                        <li><a asp-area="" asp-controller="Order" asp-action="MyOrders">Siparişlerim</a></li>
                        <li><a asp-area="" asp-controller="Profile" asp-action="Addresses">Adreslerim</a></li>
                    }
                    else
                    {
                        <li><a asp-area="" asp-controller="Account" asp-action="Login">Giriş yap</a></li>
                        <li><a asp-area="" asp-controller="Account" asp-action="Register">Üye ol</a></li>
                    }
                    <li><a asp-area="" asp-controller="Cart" asp-action="Index">Sepetim</a></li>
                </ul>
            </div>
        </div>
        <div class="footer-bottom">
            <span>© @DateTime.Now.Year Jona. Tüm hakları saklıdır.</span>
            <div class="footer-badges">
                <span><i class="bi bi-shield-lock"></i> Güvenli ödeme</span>
                <span><i class="bi bi-truck"></i> Ücretsiz kargo</span>
                <span><i class="bi bi-arrow-counterclockwise"></i> 14 gün iade</span>
            </div>
        </div>
    </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
<script>
    document.addEventListener('click', e => {
        const btn = e.target.closest('.password-toggle');
        if (!btn) return;
        const input = btn.parentElement.querySelector('input');
        const show = input.type === 'password';
        input.type = show ? 'text' : 'password';
        btn.querySelector('i').className = show ? 'bi bi-eye-slash' : 'bi bi-eye';
        const label = show ? 'Şifreyi gizle' : 'Şifreyi göster';
        btn.setAttribute('aria-label', label);
        btn.title = label;
        btn.setAttribute('aria-pressed', show);
        input.focus();
    });
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
