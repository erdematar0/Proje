@model ContactMessageDto
@{
    ViewData["Title"] = Model.Subject;
    var quoted = string.Join("\n", Model.Message.Split('\n').Select(l => "> " + l));
    var mailto = $"mailto:{Model.Email}?subject={Uri.EscapeDataString("Re: " + Model.Subject)}" +
                 $"&body={Uri.EscapeDataString($"Merhaba {Model.Name},\n\n\n\n---\n{quoted}")}";
}
<nav class="small mb-3"><a asp-action="Index">Mesajlar</a> / @Model.Subject</nav>
<div class="row g-4">
    <div class="col-xl-8">
        <div class="panel">
            <div class="d-flex justify-content-between align-items-start gap-2 mb-3">
                <div>
                    <h1 class="h5 mb-1">@Model.Subject</h1>
                    <div class="small text-muted">@Model.CreatedDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</div>
                </div>
                <partial name="_MessageStatusBadge" model="Model.Status" />
            </div>
            <p class="msg-body mb-4">@Model.Message</p>
            <a href="@mailto" class="btn btn-accent"><i class="bi bi-reply"></i> E-posta ile yanıtla</a>
            <span class="small text-muted ms-2">Yanıtladıktan sonra durumu "Yanıtlandı" yapmayı unutma.</span>
        </div>
    </div>
    <div class="col-xl-4">
        <div class="panel mb-4">
            <h2 class="h6 mb-3">Gönderen</h2>
            <div class="small mb-1"><strong>@Model.Name</strong></div>
            <div class="small mb-1"><i class="bi bi-envelope me-2"></i>@Model.Email</div>
            <div class="small mb-2"><i class="bi bi-telephone me-2"></i>@(Model.Phone ?? "—")</div>
            @if (Model.UserId is not null)
            {
                <a asp-controller="Users" asp-action="Detail" asp-route-id="@Model.UserId" class="small">Üye profili ve siparişleri →</a>
            }
            else
            {
                <span class="small text-muted">Üye olmadan gönderdi.</span>
            }
        </div>
        <form asp-action="Update" asp-route-id="@Model.Id" method="post" class="panel mb-3">
            <h2 class="h6 mb-3">Takip</h2>
            <label class="form-label small" for="status">Durum</label>
            <select name="status" id="status" class="form-select form-select-sm mb-3">
                <option value="@((int)ContactMessageStatus.Read)" selected="@(Model.Status != ContactMessageStatus.Replied)">Okundu / bekliyor</option>
                <option value="@((int)ContactMessageStatus.Replied)" selected="@(Model.Status == ContactMessageStatus.Replied)">Yanıtlandı</option>
            </select>
            <label class="form-label small" for="adminNote">Not <span class="text-muted">(sadece yöneticiler görür)</span></label>
            <textarea name="adminNote" id="adminNote" class="form-control form-control-sm mb-3" rows="3" maxlength="1000">@Model.AdminNote</textarea>
            @if (Model.RepliedDate is { } replied) { <div class="small text-muted mb-2">Yanıtlandı: @replied.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</div> }
            <button class="btn btn-sm btn-ink">Kaydet</button>
        </form>
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Mesaj kalıcı olarak silinsin mi?')">
            <button class="btn btn-sm btn-outline-danger">Mesajı sil</button>
        </form>
    </div>
</div>
