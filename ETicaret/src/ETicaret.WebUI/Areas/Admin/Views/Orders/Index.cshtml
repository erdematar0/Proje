@model List<OrderDto>
@{ ViewData["Title"] = "Siparişler"; }
<h1 class="h4 mb-3">Siparişler</h1>
<div class="panel p-0">
<table class="table align-middle mb-0">
    <thead><tr><th>No</th><th>Müşteri</th><th>Şehir</th><th>Tarih</th><th class="text-end">Tutar</th><th>Durum</th></tr></thead>
    <tbody>
    @foreach (var o in Model)
    {
        <tr>
            <td>@o.OrderNumber<div class="small text-muted">@(string.Join(", ", o.Items.Select(i => $"{i.ProductName}×{i.Quantity}")))</div></td>
            <td><a asp-controller="Users" asp-action="Detail" asp-route-id="@o.UserId">@o.FullName</a><div class="small text-muted">@o.UserEmail</div></td>
            <td>@o.City</td>
            <td>@o.CreatedDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
            <td class="text-end">@o.TotalPrice.ToTL()</td>
            <td><partial name="_OrderStatusForm" model="o" /></td>
        </tr>
    }
    @if (!Model.Any()) { <tr><td colspan="6" class="text-muted">Henüz sipariş yok.</td></tr> }
    </tbody>
</table>
</div>
