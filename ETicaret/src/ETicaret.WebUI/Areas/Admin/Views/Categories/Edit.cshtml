@model CategorySaveDto
@{ ViewData["Title"] = "Kategoriyi düzenle"; }
<h1 class="h4 mb-3">Kategoriyi düzenle</h1>
<form asp-action="Edit" asp-route-id="@ViewBag.Id" method="post" class="panel" style="max-width:520px">
    <div class="mb-3"><label asp-for="Name" class="form-label">Ad</label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger small"></span></div>
    <div class="mb-3"><label asp-for="Description" class="form-label">Açıklama</label><textarea asp-for="Description" class="form-control" rows="3"></textarea><span asp-validation-for="Description" class="text-danger small"></span></div>
    <button class="btn btn-accent">Güncelle</button> <a asp-action="Index" class="btn btn-link">Vazgeç</a>
</form>
