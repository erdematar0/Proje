@model List<UserSummaryDto>
@{ ViewData["Title"] = "Kullanıcılar"; }
<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <h1 class="h4 m-0">Kullanıcılar <span class="text-muted fs-6">(@Model.Count)</span></h1>
    <form method="get" class="d-flex gap-2">
        <input name="q" value="@ViewBag.Query" class="form-control form-control-sm" placeholder="Ad veya e-posta ara…" style="width:240px" />
        <button class="btn btn-sm btn-ink">Ara</button>
        @if (!string.IsNullOrEmpty(ViewBag.Query as string)) { <a asp-action="Index" class="btn btn-sm btn-link">Temizle</a> }
    </form>
</div>
<div class="panel p-0">
<table class="table align-middle mb-0">
    <thead><tr><th>Ad Soyad</th><th>E-posta / Telefon</th><th>Rol</th><th class="text-end">Sipariş</th><th class="text-end">Harcama</th><th>Son sipariş</th><th></th></tr></thead>
    <tbody>
    @foreach (var u in Model)
    {
        <tr>
            <td>
                @u.FullName
                @if (u.IsLockedOut) { <span class="badge text-bg-danger ms-1" title="Çok fazla hatalı giriş">Kilitli</span> }
            </td>
            <td>@u.Email<div class="small text-muted">@u.Phone</div></td>
            <td>@foreach (var r in u.Roles) { <span class="badge @(r == "Admin" ? "text-bg-dark" : "text-bg-light border") me-1">@(r == "Admin" ? "Admin" : "Müşteri")</span> }</td>
            <td class="text-end">@u.OrderCount</td>
            <td class="text-end">@u.TotalSpent.ToTL()</td>
            <td class="small">@(u.LastOrderDate?.ToLocalTime().ToString("dd.MM.yyyy") ?? "—")</td>
            <td class="text-end text-nowrap">
                <a asp-action="Detail" asp-route-id="@u.Id" class="btn btn-sm btn-outline-secondary">Detay</a>
                <a asp-action="Edit" asp-route-id="@u.Id" class="btn btn-sm btn-outline-secondary" title="Düzenle"><i class="bi bi-pencil"></i></a>
            </td>
        </tr>
    }
    @if (!Model.Any()) { <tr><td colspan="7" class="text-muted">Kullanıcı bulunamadı.</td></tr> }
    </tbody>
</table>
</div>
