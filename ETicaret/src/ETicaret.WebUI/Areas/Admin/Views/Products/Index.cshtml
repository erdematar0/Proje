@model List<ProductDto>
@{ ViewData["Title"] = "Ürünler"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 m-0">Ürünler</h1>
    <a asp-action="Create" class="btn btn-accent btn-sm"><i class="bi bi-plus-lg"></i> Yeni ürün</a>
</div>
<div class="panel p-0">
<table class="table align-middle mb-0">
    <thead><tr><th></th><th>Ad</th><th>Kategori</th><th class="text-end">Fiyat</th><th class="text-end">Stok</th><th>Durum</th><th></th></tr></thead>
    <tbody>
    @foreach (var p in Model)
    {
        <tr class="@(p.IsActive ? "" : "opacity-50")">
            <td><img src="@p.ImageUrl" width="48" height="36" style="object-fit:contain;background:var(--surface-2)" class="rounded" alt="" /></td>
            <td>@p.Name</td>
            <td>@p.CategoryName</td>
            <td class="text-end">@p.Price.ToTL()</td>
            <td class="text-end">@p.Stock</td>
            <td>@(p.IsActive ? "Yayında" : "Pasif")</td>
            <td class="text-end text-nowrap">
                <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-secondary">Düzenle</a>
                @if (p.IsActive)
                {
                    <form asp-action="Delete" asp-route-id="@p.Id" method="post" class="d-inline" onsubmit="return confirm('Ürün pasife alınsın mı?')">
                        <button class="btn btn-sm btn-outline-danger">Sil</button>
                    </form>
                }
            </td>
        </tr>
    }
    </tbody>
</table>
</div>
