@model ProductSaveDto
@{ ViewData["Title"] = "Ürünü düzenle"; }
<h1 class="h4 mb-3">Ürünü düzenle</h1>
<form asp-action="Edit" asp-route-id="@ViewBag.Id" method="post" enctype="multipart/form-data" class="panel">
    <partial name="_Form" model="Model" />
    <div class="mt-4 d-flex gap-2"><button class="btn btn-accent">Güncelle</button><a asp-action="Index" class="btn btn-link">Vazgeç</a></div>
</form>
@section Scripts { <partial name="_ValidationScripts" /> }
